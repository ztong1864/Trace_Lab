# Required for agentic controller mode.
OPENAI_API_KEY=

# Optional. Set this when using an OpenAI-compatible proxy or custom endpoint.
OPENAI_BASE_URL=

# Optional local defaults.
TRACE_LAB_PROJECTS_ROOT=runs/lab_projects
TRACE_LAB_HOST=127.0.0.1
TRACE_LAB_PORT=8788

# Only with docker-compose.foundryclaw.yml (TRACE next to FounDryClaw):
# FounDryClaw's workspace folder on this host, and the account FounDryClaw runs as.
# FOUNDRYCLAW_WORKSPACE=/srv/foundryclaw/workspace
# TRACE_UID=1000
# TRACE_GID=1000
